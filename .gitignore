# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Node.js / npm
**/node_modules/
**/.npm/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Next.js / frontend build output
**/.next/
**/out/
**/.vercel/
**/coverage/
**/dist/
**/build/
**/*.tsbuildinfo
**/next-env.d.ts

# PHP / Composer / Laravel
**/vendor/
**/public/build/
**/public/hot
**/public/storage
**/storage/logs/*
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/bootstrap/cache/*.php
**/.phpunit.cache/
**/.phpunit.result.cache
**/phpunit.xml.bak

# Keep Laravel's directory placeholders, if present
!apps/api/storage/**/.gitignore
!apps/api/bootstrap/cache/.gitignore

# Logs, temporary files, databases and runtime output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.sqlite
*.sqlite3
*.db

# Operating systems and IDEs
.DS_Store
Thumbs.db
*.swp
*.swo
*.pem
.idea/
.vscode/
.cursor/
.nova/
.zed/

# Local tooling
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml