# Environment files: never commit local secrets
/.env
/.env.*
!/.env.example
!/.env.*.example

# Dependencies
/vendor/
/node_modules/

# Laravel generated files
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/pail

# Logs and runtime data
*.log
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*

# Generated framework cache
/bootstrap/cache/*.php

# Tests and coverage
/.phpunit.cache/
/.phpunit.result.cache
/phpunit.xml.bak

# Local tools and IDEs
/.phpactor.json
/_ide_helper.php
/.codex
/.cursor
/.idea
/.nova
/.vscode
/.zed

# Composer credentials
/auth.json

# Local development files
/Homestead.json
/Homestead.yaml
Thumbs.db
.DS_Store

# Keep Laravel directory placeholders
!/storage/**/.gitignore
!/bootstrap/cache/.gitignore